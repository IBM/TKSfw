{
  "perplexity": {
    "command": "npx",
    "args": ["-y", "@perplexity-ai/mcp-server"],
    "env_vars": ["PERPLEXITY_API_KEY"],
    "startup_timeout_sec": 120,
    "tool_timeout_sec": 180
  },
  "playwright": {
    "command": "npx",
    "args": ["-y", "@playwright/mcp", "--isolated", "--output-dir", ".playwright"],
    "startup_timeout_sec": 120,
    "tool_timeout_sec": 120
  }
}
