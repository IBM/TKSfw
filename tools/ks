def cmd_hil(home, args):
    """ks hil show | set [--impact L] [--reversibility L] [--logic and|or] [--mode enforce|advisory]"""
    sub = args[0] if args else "show"
    proj = Project(home)
    pol, V = hil_read(proj)
    if sub == "show":
        print(f"HIL threshold: {V.hil_describe(pol)}")
        for k in ("impact", "reversibility", "logic", "mode"):
            print(f"  {k} = {pol[k]}")
        print("  rule: AGENTS.md § Human in the Loop — at/above threshold: ConfirmationType OPERATOR; Workers leave it OPEN")
        sys.exit(0)
    if sub == "set":
        new = dict(pol)
        it = iter(args[1:])
        for a in it:
            key = a[2:]
            if key not in HIL_KEYS:
                die(f"usage: {cmd_hil.__doc__}")
            val = next(it, None)
            if val is None:
                die(f"--{key} needs a value: {HIL_KEYS[key]}")
            val = val.upper() if key in ("impact", "reversibility") else val.lower()
            if val not in HIL_KEYS[key]:
                die(f"--{key}: {val!r} not in {HIL_KEYS[key]}")
            new[key] = val
        if new == pol:
            print(f"HIL threshold unchanged: {V.hil_describe(pol)}")
            sys.exit(0)
        path = proj.config_toml()
        text = open(path, encoding="utf-8").read()
        block = ('[hil]                            # Human in the Loop threshold (AGENTS.md § Human in the Loop) — `ks hil show|set`\n'
                 f'impact = "{new["impact"]}"\n'
                 f'reversibility = "{new["reversibility"]}"\n'
                 f'logic = "{new["logic"]}"\n'
                 f'mode = "{new["mode"]}"\n')
        m = re.search(r'^\[hil\][^\n]*\n(?:(?!\[)[^\n]*\n?)*', text, re.M)
        if m:
            text = text[:m.start()] + block + ("\n" if not text[m.end():].startswith("\n") and text[m.end():] else "") + text[m.end():]
        else:
            text = text.rstrip("\n") + "\n\n" + block
        open(path, "w", encoding="utf-8").write(text)
        import tomllib
        with open(path, "rb") as fh:
            tomllib.load(fh)                                # must still parse
        print(f"HIL threshold: {V.hil_describe(new)} (was {V.hil_describe(pol)})")
        effect("decision")
        sys.exit(0)
    die(f"usage: {cmd_hil.__doc__}")


