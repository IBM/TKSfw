        sys.exit(rc)
    if sub == "reset":
        cmd_reset(home, rest)
        return
    if sub == "status":
        cmd_status(home, rest)
        return
    die("usage: ks project init [dir] [--full] | update [dir] | enable | disable | status | drift [--json] | reset [--archive [--label L]] [--keep-agents] [--registry] [--dry-run] [--yes] [--force]")


SHARD_RE = re.compile(r"^(changes|lessons|handoffs|events|decisions)\.([0-9A-Za-z]{8})\.yaml$")
LEDGER_NAMES = ("changes.yaml", "lessons.yaml", "handoffs.yaml", "events.yaml", "decisions.yaml")


def cmd_reset(home, args):
    """ks project reset [--archive [--label NAME]] [--keep-agents] [--registry] [--dry-run] [--yes] [--force]"""
    import time, glob
    proj = Project(home)
    archive = "--archive" in args
    label = args[args.index("--label") + 1] if "--label" in args else ""
    keep_agents, registry, dry, yes, force = "--keep-agents" in args, "--registry" in args, "--dry-run" in args, "--yes" in args, "--force" in args
    wa = proj.workarea
    root = proj.root
    if not dry:
        refuse_if_busy(proj, "project reset", args, sessions=True)
    # ---- plan
    groups = {}                                            # name → [(abs path, kind: file|dir)]
    def add(name, path):
        if os.path.exists(path):
            groups.setdefault(name, []).append(path)
    names = os.listdir(wa) if os.path.isdir(wa) else []
    for n in names:
        p = os.path.join(wa, n)
        if n in LEDGER_NAMES or SHARD_RE.match(n):
            add("ledgers", p)
        elif n in ("tasks.md", "tasks-archive.md", "STATE.md"):
            add("plan & view", p)
        elif n == "archive":
            add("archives", p)
        elif n == "exports":
            add("exports", p)
        elif n == ".hook-state":
            add("hook state", p)
        elif n == "deliverables.yaml":
            if registry:
                add("registry", p)
        elif os.path.isdir(p) and n != ".keep":
            add("work areas", p)
    wt_dir = os.path.join(root, ".agents", "worktrees")
    worktrees = [d for d in glob.glob(os.path.join(wt_dir, "*")) if os.path.isdir(d)]
    for d in worktrees:
        add("worktrees", d)
    agents_dir = os.path.join(root, ".agents", "agents")
    agent_files = [] if keep_agents else [p for p in glob.glob(os.path.join(agents_dir, "*.toml"))]
    for p in agent_files:
        add("agent definitions", p)
    for p in agent_files:
        name = os.path.splitext(os.path.basename(p))[0]
        for mirror in (os.path.join(root, ".codex", "agents", name + ".toml"), os.path.join(root, ".claude", "agents", name + ".md")):
            add("agent mirrors", mirror)
    if not groups:
        print("nothing to reset — the project is already clean")
        return
    stamp = time.strftime("%Y%m%d-%H%M")
    hist = os.path.join(root, ".agents", "history", stamp + (f"-{re.sub(r'[^A-Za-z0-9_-]', '_', label)}" if label else ""))
    unmerged = []
    if worktrees and shutil.which("git"):
        for d in worktrees:
            branch = "agent/" + os.path.basename(d).replace("--", "/", 1)
            r = run(["git", "branch", "--merged", "HEAD", "--format=%(refname:short)"], cwd=root, capture=True)
            if r.returncode == 0 and branch not in {l.strip() for l in r.stdout.splitlines()}:
                unmerged.append(branch)
    print(f"reset plan for {root}  ({'ARCHIVE to ' + os.path.relpath(hist, root) if archive else 'CLEAR'})")
    archived_groups = {"ledgers", "plan & view", "archives", "exports", "work areas", "agent definitions", "registry"}
    for g, items in groups.items():
        action = "→ history" if archive and g in archived_groups else "delete"
        print(f"  {g:<18} {len(items):>3}  {action}")
    if unmerged:
        print("  unmerged worktree branches: " + ", ".join(unmerged) + ("  (kept)" if archive else ("  (DELETED with --force)" if force else "  → refusing without --force")))
    if dry:
        print("dry run — nothing changed")
        return
    if unmerged and not archive and not force:
        die("refusing: unmerged worktree branches would be lost — merge them, use --archive (keeps branches) or --force")
    if not yes:
        if sys.stdin.isatty() and sys.stdout.isatty():          # a real terminal on both ends; never prompt into a pipe
            ans = input("Proceed? Type 'reset' to confirm: ").strip()
            if ans != "reset":
                die("aborted")
        else:
            die("refusing without --yes (non-interactive)")
    # ---- execute
    def move_or_delete(path, group):
        if archive and group in archived_groups:
            rel = os.path.relpath(path, root)
            dst = os.path.join(hist, rel.replace(".agents/", "", 1))
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.move(path, dst)
        elif os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)
        else:
            os.remove(path)
    for d in worktrees:
        run(["git", "worktree", "remove", "--force", d], cwd=root, capture=True)
        if os.path.isdir(d):
            shutil.rmtree(d, ignore_errors=True)
        branch = "agent/" + os.path.basename(d).replace("--", "/", 1)
        if not archive:
            run(["git", "branch", "-D", branch], cwd=root, capture=True)
    if shutil.which("git"):
        run(["git", "worktree", "prune"], cwd=root, capture=True)
    for g, items in groups.items():
        if g == "worktrees":
            continue
        for p in items:
            if os.path.exists(p):
                move_or_delete(p, g)
    os.makedirs(wa, exist_ok=True)
    open(os.path.join(wa, ".keep"), "a").close()
    if not keep_agents:
        os.makedirs(agents_dir, exist_ok=True)
        open(os.path.join(agents_dir, ".keep"), "a").close()
    # ---- record the generation in the manifest
    mp = os.path.join(root, ".agents", ".tksfw.json")
    try:
        m = json.load(open(mp))
    except Exception:
        m = proj.manifest or {}
    op = run([PY, home.new_project, "--show-operator"], capture=True).stdout
    op = op.split("operator:", 1)[1].split("(")[0].strip() if "operator:" in op else ""
    m.setdefault("resets", []).append({"ts": time.strftime("%Y-%m-%d %H:%M:%S"), "operator": op,
                                      "mode": "archive" if archive else "clear",
                                      "history": os.path.relpath(hist, root) if archive else "",
                                      "kept_agents": keep_agents, "cleared_registry": registry})
    with open(mp, "w", encoding="utf-8") as fh:
        json.dump(m, fh, indent=2, sort_keys=True)
        fh.write("\n")
    print(f"reset done — generation {len(m['resets']) + 1}" + (f"; previous generation in {os.path.relpath(hist, root)}" if archive else ""))
    effect("files")
    print("→ commit the working tree; the next session starts with empty ledgers and a fresh token")


def all_sessions(proj):
    d = os.path.join(proj.workarea or "", ".hook-state", "sessions")
    out = []
    try:
        for f in os.listdir(d):
            if f.endswith(".json"):
                rec = json.load(open(os.path.join(d, f)))
                if isinstance(rec, dict) and rec.get("token"):
                    rec["_path"] = os.path.join(d, f)
                    out.append(rec)
    except Exception:
        pass
    return out


def active_sessions(proj, within=1800):
    """Active = heartbeat within `within` seconds AND not ended (SessionEnd hook / `ks project sessions close`)."""
    import time
    now = time.time()
    return [r for r in all_sessions(proj) if not r.get("ended") and now - float(r.get("last_seen", 0)) <= within]


def close_sessions(proj, tokens=None, stale=False, within=1800):
    """Mark session records ended by hand (a harness that quit without SessionEnd, or an old plugin).
    `tokens`: explicit; `stale=True`: every un-ended record whose heartbeat is older than `within`."""
    import time
    now = time.time()
    done = []
    for r in all_sessions(proj):
        if r.get("ended"):
            continue
        if (tokens and r["token"] in tokens) or (stale and now - float(r.get("last_seen", 0)) > within) or (tokens is None and not stale):
            path = r.pop("_path")
            r["ended"] = now; r["end_reason"] = "ks project sessions close"
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(r, fh, indent=1)
            os.replace(tmp, path)
            done.append(r["token"])
    return done


def apply_main_model(proj, quiet=False):
    """3.2.0 — the main session runs on the judge tier of the active routing table. Write it where each
    harness reads its startup model: Claude Code `.claude/settings.local.json` (`model`; project-local, wins
    over the user default, not template-managed), Codex `.codex/config.toml` (`model`, `model_reasoning_effort`).
    Applies at the next launch; the current session must switch by hand (`/model`). Returns the lines printed."""
    rm = os.path.join(proj.hooks, "route_model.py")
    r = run([PY, rm, "--main"], cwd=proj.root, env=proj.env(), capture=True)
    try:
        mm = json.loads(r.stdout)
    except Exception:
        return []
    lines, notes = [], []
    cl = mm.get("claude") or {}
    if cl.get("model"):
        sl = os.path.join(proj.root, ".claude", "settings.local.json")
        data = {}
        if os.path.isfile(sl):
            try:
                data = json.load(open(sl, encoding="utf-8"))
            except Exception:
                data = {}
        env = dict(data.get("env") or {})
        for k in [k for k in env if k.startswith("ANTHROPIC_DEFAULT_") and k.endswith("_MODEL")]:
            env.pop(k)
        for alias, mid in (cl.get("aliases") or {}).items():          # alias → routed id (third-party ids included)
            if alias and mid:
                env[f"ANTHROPIC_DEFAULT_{alias.upper()}_MODEL"] = mid
        changed = data.get("model") != cl["model"] or (data.get("env") or {}) != env
        if changed:
            data["model"] = cl["model"]
            data["env"] = env
            os.makedirs(os.path.dirname(sl), exist_ok=True)
            json.dump(data, open(sl, "w", encoding="utf-8"), indent=2)
            open(sl, "a", encoding="utf-8").write("\n")
        amap = ", ".join(f"{a}{ui.sym('arrow')}{m}" for a, m in (cl.get("aliases") or {}).items())
        lines.append("  Claude Code   main " + ui.bold(cl['model']) + ui.dim(f" {ui.sym('dot')} aliases {amap}"))
        notes.append(f"Claude Code: written to .claude/settings.local.json for the next launch — now: `/model {cl['model']}`; restart Claude Code for the aliases")
    cx = mm.get("codex") or {}
    if cx.get("model"):
        cp = os.path.join(proj.root, ".codex", "config.toml")
        text = open(cp, encoding="utf-8").read() if os.path.isfile(cp) else ""
        body = [l for l in text.splitlines(keepends=True) if not re.match(r'^(model|model_reasoning_effort)\s*=', l)]
        ins = f'model = "{cx["model"]}"                      # main session = judge tier of [routing.{cx["routing"]}] — written by `ks` (routing use / project update)\n'
        if cx.get("reasoning_effort"):
            ins += f'model_reasoning_effort = "{cx["reasoning_effort"]}"\n'
        # insert before the first table header (top-level keys must precede tables)
        idx = next((i for i, l in enumerate(body) if l.startswith("[")), len(body))
        # after the leading comment block / default_permissions line
        body[idx:idx] = [ins]
        new = "".join(body)
        if new != text:
            open(cp, "w", encoding="utf-8").write(new)
        lines.append("  Codex         main " + ui.bold(cx['model']) + (f" / {cx['reasoning_effort']}" if cx.get("reasoning_effort") else ""))
        notes.append("Codex: written to .codex/config.toml for the next launch — now: `/model`")
    # re-render the agent mirrors (.claude/agents/*.md carry the full routed id; .codex/agents/*.toml the id + effort)
    agents_dir = os.path.join(proj.root, ".agents", "agents")
    if os.path.isdir(agents_dir) and any(f.endswith(".toml") for f in os.listdir(agents_dir)):
        code = ("import sys, json; sys.path.insert(0, sys.argv[1]); import agentlib; "
                "res = agentlib.sync(check=False); print(json.dumps([list(r[:2]) for r in res]))")
        r = run([PY, "-c", code, proj.hooks], cwd=proj.root, env=proj.env(), capture=True)
        try:
            res = json.loads((r.stdout or "").strip().splitlines()[-1])
            n = len([x for x in res if x[0] == "wrote"])
            bad = [x for x in res if x[0] == "conflict"]
        except Exception:
            n, bad = 0, []
        if n:
            lines.append("  " + ui.dim(f"agent mirrors re-rendered with the routed models: {n} file(s) (.claude/agents, .codex/agents)"))
        if bad:
            lines.append("  " + ui.mark("warn") + f" agent mirrors NOT rendered for {len(bad)} source(s) — fix them (`ks harness sync --check` in full mode): " + ", ".join(x[1] for x in bad))
    if not quiet:
        rt = (cl.get("routing") or cx.get("routing") or "?")
        for l in lines:
            print(l)
        for n_ in notes:
            ui.hint(n_)
    return lines


