def cmd_dev(home, args):
    if home.kind != "repo":
        die("ks dev needs a repository checkout (TKSFW_HOME pointing at it)")
    sub = args[0] if args else "test"
    if sub == "build":
        sys.exit(run([PY, os.path.join(home.path, "tools", "build_plugin.py"), *args[1:]], cwd=home.path).returncode)
    if sub == "test":
        sys.exit(run([PY, os.path.join(home.path, "tests", "run_tests.py")], cwd=home.path).returncode)
    if sub == "release":
        sys.exit(run(["bash", os.path.join(home.path, "tools", "release.sh"), *args[1:]], cwd=home.path).returncode)
    die("usage: ks dev build | test | release <version>")




