#!/usr/bin/env python3
"""ks — the TKSfw command line (one front door for every framework operation).

    ks self install | setup | version | home      put ks on PATH; one-shot user setup; version / home
    ks operator set <name> | show                 per-user ~/.config/tksfw/user.toml
    ks project init [dir] [--full] | update [dir] | enable | disable | status | drift [--json]
    ks project reset [--archive [--label L]] [--keep-agents] [--registry] [--dry-run] [--yes] [--force]
    ks routing show | check | resolve <agent> | use <table> | use --clear
    ks hil show | set [--impact L] [--reversibility L] [--logic and|or] [--mode enforce|advisory]
    ks ledger check | find <id> [--refs] [--json] | digest [--task T] [--agent A] [--json]
              | export all|<kinds> [--out F] [--archive] [--csv DIR]
              | archive-plan [--dry-run] | archive <ledger|all> --before YYYY-MM-DD [--dry-run]
    ks harness sync [--check] | retrust [--ack]
    ks doctor                                     installation integrity (user-level + project)
    ks dev build | test | release <version>       repository checkout only

ks is a thin dispatcher: every operation is an existing framework script (hooks, skill assets,
tools/new_project.py); ks only resolves WHERE they are and adds status/doctor/retrust/drift views.
Standard library only, Python ≥ 3.11 (the same dependency as the hooks).

Framework home resolution: $TKSFW_HOME → `home = "…"` in ~/.config/tksfw/user.toml → this script's
own location (tools/ks in a checkout, bin/ks in the plugin) → harness plugin directories.
Project resolution: $TKSFW_PROJECT_ROOT → nearest ancestor of cwd with .agents/.tksfw.json.
"""
import sys
sys.dont_write_bytecode = True
import os
import re
import json
import shutil
import hashlib
import platform
import subprocess
import signal

try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)      # `ks … | head` must not trace
except Exception:
    pass

PY = sys.executable
HERE = os.path.dirname(os.path.realpath(__file__))
CONFIG_DIR = os.environ.get("TKSFW_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".config", "tksfw")
USER_TOML = os.path.join(CONFIG_DIR, "user.toml")
TRUST_JSON = os.path.join(CONFIG_DIR, "trust.json")


# ----------------------------------------------------------------------------- output
def die(msg, rc=1):
    sys.stderr.write(msg.rstrip("\n") + "\n")
    sys.exit(rc)


def run(cmd, cwd=None, env=None, check=False, capture=False):
    r = subprocess.run(cmd, cwd=cwd, env=env, text=True, capture_output=capture)
    if check and r.returncode:
        sys.exit(r.returncode)
    return r


# ----------------------------------------------------------------------------- home
def user_toml():
    out = {}
    try:
        for line in open(USER_TOML, encoding="utf-8"):
            m = re.match(r'^\s*(\w+)\s*=\s*"([^"]*)"\s*(#.*)?$', line)
            if m:
                out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def home_kind(path):
    """'repo' (checkout: tools/ + template/), 'plugin' (bundle: hooks/ + skills/tksfw-init/assets/template) or None."""
    if not path or not os.path.isdir(path):
        return None
    if os.path.isdir(os.path.join(path, "template")) and os.path.isfile(os.path.join(path, "tools", "new_project.py")):
        return "repo"
    if os.path.isdir(os.path.join(path, "hooks")) and os.path.isdir(os.path.join(path, "skills", "tksfw-init", "assets", "template")):
        return "plugin"
    return None


def candidate_homes():
    yield os.environ.get("TKSFW_HOME"), "TKSFW_HOME"
    yield user_toml().get("home"), "user.toml"
    yield os.path.dirname(HERE), "script location"
    codex_home = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
    for base in (os.path.join(codex_home, "plugins"), os.path.join(os.path.expanduser("~"), ".claude", "plugins")):
        if os.path.isdir(base):
            for root, dirs, _files in os.walk(base):
                if os.path.basename(root) == "tksfw" and home_kind(root) == "plugin":
                    yield root, base
                if root.count(os.sep) - base.count(os.sep) > 4:
                    dirs[:] = []


class Home:
    def __init__(self):
        self.path, self.how, self.kind = None, None, None
        for p, how in candidate_homes():
            k = home_kind(p)
            if k:
                self.path, self.how, self.kind = os.path.abspath(p), how, k
                break
        if not self.path:
            die("TKSfw home not found — set TKSFW_HOME, or `ks self install` from a checkout / plugin bundle")
        if self.kind == "repo":
            self.template = os.path.join(self.path, "template")
            self.new_project = os.path.join(self.path, "tools", "new_project.py")
            self.hooks = os.path.join(self.template, ".agents", "hooks")
            self.skills = os.path.join(self.template, ".agents", "skills")
            self.version = open(os.path.join(self.path, "VERSION")).read().strip()
        else:
            assets = os.path.join(self.path, "skills", "tksfw-init", "assets")
            self.template = os.path.join(assets, "template")
            self.new_project = os.path.join(assets, "new_project.py")
            self.hooks = os.path.join(self.path, "hooks")
            self.skills = os.path.join(self.path, "skills")
            self.version = open(os.path.join(assets, "VERSION")).read().strip()

    def asset(self, skill, name):
        return os.path.join(self.skills, skill, "assets", name)


# ----------------------------------------------------------------------------- project
class Project:
    def __init__(self, home, path=None, required=True):
        p = path or os.environ.get("TKSFW_PROJECT_ROOT")
        if not p:
            cur = os.getcwd()
            while True:
                if os.path.isfile(os.path.join(cur, ".agents", ".tksfw.json")):
                    p = cur
                    break
                parent = os.path.dirname(cur)
                if parent == cur:
                    break
                cur = parent
        self.root = os.path.abspath(p) if p else None
        if not self.root and required:
            die("not inside a TKSfw project (no .agents/.tksfw.json upward from cwd; set TKSFW_PROJECT_ROOT)")
        self.manifest = {}
        if self.root:
            try:
                self.manifest = json.load(open(os.path.join(self.root, ".agents", ".tksfw.json")))
            except Exception:
                self.manifest = {}
        # in-project tooling (full mode) is the pinned version and wins over the home copy
        self.hooks = os.path.join(self.root, ".agents", "hooks") if self.root and os.path.isfile(os.path.join(self.root, ".agents", "hooks", "hooks.json")) else home.hooks
        self.skills = os.path.join(self.root, ".agents", "skills") if self.root and os.path.isdir(os.path.join(self.root, ".agents", "skills", "yaml-log-entry")) else home.skills
        self.workarea = os.path.join(self.root, ".agents", "workarea") if self.root else None

    def env(self):
        e = dict(os.environ)
        if self.root:
            e["TKSFW_PROJECT_ROOT"] = self.root
        return e

    def asset(self, skill, name):
        return os.path.join(self.skills, skill, "assets", name)


# ----------------------------------------------------------------------------- effects / safety
EFFECT = {
    "spawn": "takes effect at the next subagent spawn (no restart); the model is told at its next prompt",
    "prompt": "takes effect immediately; the model is told at its next prompt",
    "session": "takes effect at the next session: restart the harness; Codex → /hooks re-trust, then `ks harness retrust --ack`",
    "files": "files changed now; the session sees them at its next prompt, STATE.md at its next turn end",
    "decision": "applies to the next decision entry (no restart); the model is told at its next prompt; STATE.md re-marks pending decisions at its next turn end",
}


def effect(kind):
    print(f"→ {EFFECT[kind]}")


def live_subagents(proj):
    """Live subagents in this project (all sessions) from .hook-state/subagents.json."""
    import time, glob
    out = []
    for p in glob.glob(os.path.join(proj.workarea or "", ".hook-state", "hosts", "*", "subagents.json")) + \
             [os.path.join(proj.workarea or "", ".hook-state", "subagents.json")]:
        try:
            live = json.load(open(p)).get("live", {})
            out += [e for e in live.values() if time.time() - float(e.get("ts", 0)) < 4 * 3600]
        except Exception:
            pass
    return out


def refuse_if_busy(proj, what, args, sessions=False):
    if "--force" in args:
        return
    live = live_subagents(proj)
    if live:
        die(f"{what}: {len(live)} subagent(s) are running in this project — wait for them to return, or --force")
    if sessions:
        act = active_sessions(proj)
        if act:
            die(f"{what}: {len(act)} session(s) active on this project (" + ", ".join(a['token'] for a in act)
                + ") — finish them first, or --force")


# ----------------------------------------------------------------------------- commands
def cmd_self(home, args):
    sub = args[0] if args else "version"
    if sub == "version":
        print(f"ks / TKSfw {home.version}  ({home.kind} at {home.path}, via {home.how})")
    elif sub == "home":
        print(home.path)
    elif sub == "install":
        bin_dir = args[args.index("--bin-dir") + 1] if "--bin-dir" in args else os.path.join(os.path.expanduser("~"), ".local", "bin")
        os.makedirs(bin_dir, exist_ok=True)
        link = os.path.join(bin_dir, "ks")
        target = os.path.realpath(__file__)
        if os.path.islink(link) or os.path.exists(link):
            os.remove(link)
        os.symlink(target, link)
        os.chmod(target, 0o755)
        # record home in user.toml (keep other keys)
        cfg = user_toml()
        cfg["home"] = home.path
        os.makedirs(CONFIG_DIR, exist_ok=True)
        lines = ["# TKSfw per-user configuration (read by the hooks, new_entry_id.py and ks)", "schema = 1"]
        for k in ("name", "home"):
            if k in cfg:
                lines.append(f'{k} = "{cfg[k]}"')
        open(USER_TOML, "w", encoding="utf-8").write("\n".join(lines) + "\n")
        comp = os.path.join(os.path.dirname(target), "ks-completion.sh")
        print(f"installed: {link} → {target}\nhome recorded: {home.path} ({USER_TOML})")
        if os.path.isfile(comp):
            print(f"completion: add `source {comp}` to ~/.zshrc or ~/.bashrc")
        if bin_dir not in os.environ.get("PATH", "").split(os.pathsep):
            print(f"note: {bin_dir} is not on PATH")
    elif sub == "setup":
        cmd_setup(home, args[1:])
    else:
        die("usage: ks self install [--bin-dir DIR] | setup [--operator NAME] [--no-stanza] | version | home")


STANZA_MARK = "TKSfw bootstrap stanza"


def append_stanza(target, stanza_path):
    """Append the bootstrap stanza to a user-level instruction file once (idempotent by marker)."""
    if not os.path.isfile(stanza_path):
        return "stanza source missing"
    cur = open(target, encoding="utf-8").read() if os.path.isfile(target) else ""
    if STANZA_MARK in cur:
        return "already present"
    os.makedirs(os.path.dirname(target), exist_ok=True)
    with open(target, "a", encoding="utf-8") as fh:
        fh.write(("\n" if cur and not cur.endswith("\n") else "") + ("\n" if cur else "") + open(stanza_path, encoding="utf-8").read())
    return "appended"


def cmd_setup(home, args):
    """One-shot, idempotent user-level setup: operator, bootstrap stanzas, completion hint, doctor."""
    op = args[args.index("--operator") + 1] if "--operator" in args else None
    r = run([PY, home.new_project, "--show-operator"], capture=True)
    if op:
        run([PY, home.new_project, "--set-operator", op], check=True)
    elif r.returncode != 0 or "source: git" in r.stdout:
        if sys.stdin.isatty() and sys.stdout.isatty():
            name = input("Operator name for ledger entries (OwnerSessionUserName): ").strip()
            if name:
                run([PY, home.new_project, "--set-operator", name], check=True)
        else:
            print("operator not configured — pass --operator \"<name>\" (non-interactive)")
    else:
        print(r.stdout.strip())
    if "--no-stanza" not in args:
        boot = os.path.join(home.path, "plugin-src", "tksfw", "bootstrap") if home.kind == "repo" else os.path.join(home.path, "bootstrap")
        codex_home = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
        for target, src in ((os.path.join(codex_home, "AGENTS.md"), "AGENTS.global.md"),
                            (os.path.join(os.path.expanduser("~"), ".claude", "CLAUDE.md"), "CLAUDE.global.md")):
            print(f"bootstrap stanza → {target}: {append_stanza(target, os.path.join(boot, src))}")
    comp = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ks-completion.sh")
    if os.path.isfile(comp):
        print(f"completion: add `source {comp}` to ~/.zshrc or ~/.bashrc")
    print("\nnext: install the plugin in each harness if not done (docs/getting-started.md), then `ks doctor`")


def cmd_operator(home, args):
    if not args or args[0] not in ("set", "show"):
        die("usage: ks operator set <name> | show")
    if args[0] == "set":
        if len(args) < 2:
            die("usage: ks operator set <name>")
        rc = run([PY, home.new_project, "--set-operator", " ".join(a for a in args[1:] if a != "--force")]).returncode
        if rc == 0:
            effect("prompt")
        sys.exit(rc)
    sys.exit(run([PY, home.new_project, "--show-operator"]).returncode)


def cmd_project(home, args):
    sub = args[0] if args else "status"
    rest = args[1:]
    if sub == "init":
        target = next((a for a in rest if not a.startswith("--")), os.getcwd())
        cmd = [PY, home.new_project, target] + ([] if "--full" in rest else ["--plugin-mode"])
        sys.exit(run(cmd).returncode)
    if sub in ("update", "enable", "disable", "drift"):
        target = next((a for a in rest if not a.startswith("--")), None)
        proj = Project(home, target)
        if sub == "update":
            refuse_if_busy(proj, "project update", rest, sessions=True)
        cmd = [PY, home.new_project, proj.root, "--" + sub] + (["--json"] if "--json" in rest else [])
        rc = run(cmd).returncode
        if rc == 0 and sub == "update":
            effect("session")
        elif rc == 0 and sub in ("enable", "disable"):
            effect("prompt" if sub == "enable" else "files")
            if sub == "disable":
                print("→ hooks are inert here from now on (the model is not told — it has no hook to tell it); `ks project enable` re-arms")
        sys.exit(rc)
    if sub == "reset":
        cmd_reset(home, rest)
        return
    if sub == "status":
        proj = Project(home)
        m = proj.manifest
        drift = run([PY, home.new_project, proj.root, "--drift", "--json"], capture=True)
        try:
            d = json.loads(drift.stdout)
        except Exception:
            d = {}
        print(f"project : {proj.root}")
        print(f"version : {m.get('version', '?')} (installed {home.version}, {home.kind} home)  ·  mode: {'plugin' if m.get('plugin_mode') else 'full'}  ·  {'ARMED' if m.get('enabled', True) is not False else 'DISARMED'}")
        if d:
            print(f"drift   : outdated {len(d.get('outdated', []))} · edited {len(d.get('edited', []))} · missing {len(d.get('missing', []))} · unchanged {len(d.get('unchanged', []))}"
                  + ("" if not d.get("drift") else "   → `ks project drift` / `ks project update`"))
        sess = active_sessions(proj)
        print(f"sessions: {len(sess)} active" + (" (" + ", ".join(f"{s['token']}/{s.get('operator') or '?'}" for s in sess) + ")" if sess else ""))
        state = os.path.join(proj.workarea, "STATE.md")
        if os.path.isfile(state):
            for line in open(state, encoding="utf-8"):
                if line.startswith("- Next action:") or line.startswith("- Active plan block:"):
                    print("plan    :", line.strip()[2:])
        wt = run([PY, proj.asset("delegate-work", "workarea.py"), "status", "--json"], cwd=proj.root, env=proj.env(), capture=True)
        try:
            w = json.loads(wt.stdout)
            print(f"isolation: {w['total']} work area(s)/worktree(s), {len(w['stale'])} stale")
        except Exception:
            pass
        return
    die("usage: ks project init [dir] [--full] | update [dir] | enable | disable | status | drift [--json] | reset [--archive [--label L]] [--keep-agents] [--registry] [--dry-run] [--yes] [--force]")


SHARD_RE = re.compile(r"^(changes|lessons|handoffs|events|decisions)\.([0-9A-Za-z]{8})\.yaml$")
LEDGER_NAMES = ("changes.yaml", "lessons.yaml", "handoffs.yaml", "events.yaml", "decisions.yaml")


def cmd_reset(home, args):
    """ks project reset [--archive [--label NAME]] [--keep-agents] [--registry] [--dry-run] [--yes] [--force]"""
    import time, glob
    proj = Project(home)
    archive = "--archive" in args
    label = args[args.index("--label") + 1] if "--label" in args else ""
    keep_agents, registry, dry, yes, force = "--keep-agents" in args, "--registry" in args, "--dry-run" in args, "--yes" in args, "--force" in args
    wa = proj.workarea
    root = proj.root
    if not dry:
        refuse_if_busy(proj, "project reset", args, sessions=True)
    # ---- plan
    groups = {}                                            # name → [(abs path, kind: file|dir)]
    def add(name, path):
        if os.path.exists(path):
            groups.setdefault(name, []).append(path)
    names = os.listdir(wa) if os.path.isdir(wa) else []
    for n in names:
        p = os.path.join(wa, n)
        if n in LEDGER_NAMES or SHARD_RE.match(n):
            add("ledgers", p)
        elif n in ("tasks.md", "tasks-archive.md", "STATE.md"):
            add("plan & view", p)
        elif n == "archive":
            add("archives", p)
        elif n == "exports":
            add("exports", p)
        elif n == ".hook-state":
            add("hook state", p)
        elif n == "deliverables.yaml":
            if registry:
                add("registry", p)
        elif os.path.isdir(p) and n != ".keep":
            add("work areas", p)
    wt_dir = os.path.join(root, ".agents", "worktrees")
    worktrees = [d for d in glob.glob(os.path.join(wt_dir, "*")) if os.path.isdir(d)]
    for d in worktrees:
        add("worktrees", d)
    agents_dir = os.path.join(root, ".agents", "agents")
    agent_files = [] if keep_agents else [p for p in glob.glob(os.path.join(agents_dir, "*.toml"))]
    for p in agent_files:
        add("agent definitions", p)
    for p in agent_files:
        name = os.path.splitext(os.path.basename(p))[0]
        for mirror in (os.path.join(root, ".codex", "agents", name + ".toml"), os.path.join(root, ".claude", "agents", name + ".md")):
            add("agent mirrors", mirror)
    if not groups:
        print("nothing to reset — the project is already clean")
        return
    stamp = time.strftime("%Y%m%d-%H%M")
    hist = os.path.join(root, ".agents", "history", stamp + (f"-{re.sub(r'[^A-Za-z0-9_-]', '_', label)}" if label else ""))
    unmerged = []
    if worktrees and shutil.which("git"):
        for d in worktrees:
            branch = "agent/" + os.path.basename(d).replace("--", "/", 1)
            r = run(["git", "branch", "--merged", "HEAD", "--format=%(refname:short)"], cwd=root, capture=True)
            if r.returncode == 0 and branch not in {l.strip() for l in r.stdout.splitlines()}:
                unmerged.append(branch)
    print(f"reset plan for {root}  ({'ARCHIVE to ' + os.path.relpath(hist, root) if archive else 'CLEAR'})")
    archived_groups = {"ledgers", "plan & view", "archives", "exports", "work areas", "agent definitions", "registry"}
    for g, items in groups.items():
        action = "→ history" if archive and g in archived_groups else "delete"
        print(f"  {g:<18} {len(items):>3}  {action}")
    if unmerged:
        print("  unmerged worktree branches: " + ", ".join(unmerged) + ("  (kept)" if archive else ("  (DELETED with --force)" if force else "  → refusing without --force")))
    if dry:
        print("dry run — nothing changed")
        return
    if unmerged and not archive and not force:
        die("refusing: unmerged worktree branches would be lost — merge them, use --archive (keeps branches) or --force")
    if not yes:
        if sys.stdin.isatty() and sys.stdout.isatty():          # a real terminal on both ends; never prompt into a pipe
            ans = input("Proceed? Type 'reset' to confirm: ").strip()
            if ans != "reset":
                die("aborted")
        else:
            die("refusing without --yes (non-interactive)")
    # ---- execute
    def move_or_delete(path, group):
        if archive and group in archived_groups:
            rel = os.path.relpath(path, root)
            dst = os.path.join(hist, rel.replace(".agents/", "", 1))
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            shutil.move(path, dst)
        elif os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)
        else:
            os.remove(path)
    for d in worktrees:
        run(["git", "worktree", "remove", "--force", d], cwd=root, capture=True)
        if os.path.isdir(d):
            shutil.rmtree(d, ignore_errors=True)
        branch = "agent/" + os.path.basename(d).replace("--", "/", 1)
        if not archive:
            run(["git", "branch", "-D", branch], cwd=root, capture=True)
    if shutil.which("git"):
        run(["git", "worktree", "prune"], cwd=root, capture=True)
    for g, items in groups.items():
        if g == "worktrees":
            continue
        for p in items:
            if os.path.exists(p):
                move_or_delete(p, g)
    os.makedirs(wa, exist_ok=True)
    open(os.path.join(wa, ".keep"), "a").close()
    if not keep_agents:
        os.makedirs(agents_dir, exist_ok=True)
        open(os.path.join(agents_dir, ".keep"), "a").close()
    # ---- record the generation in the manifest
    mp = os.path.join(root, ".agents", ".tksfw.json")
    try:
        m = json.load(open(mp))
    except Exception:
        m = proj.manifest or {}
    op = run([PY, home.new_project, "--show-operator"], capture=True).stdout
    op = op.split("operator:", 1)[1].split("(")[0].strip() if "operator:" in op else ""
    m.setdefault("resets", []).append({"ts": time.strftime("%Y-%m-%d %H:%M:%S"), "operator": op,
                                      "mode": "archive" if archive else "clear",
                                      "history": os.path.relpath(hist, root) if archive else "",
                                      "kept_agents": keep_agents, "cleared_registry": registry})
    with open(mp, "w", encoding="utf-8") as fh:
        json.dump(m, fh, indent=2, sort_keys=True)
        fh.write("\n")
    print(f"reset done — generation {len(m['resets']) + 1}" + (f"; previous generation in {os.path.relpath(hist, root)}" if archive else ""))
    effect("files")
    print("→ commit the working tree; the next session starts with empty ledgers and a fresh token")


def active_sessions(proj, within=1800):
    import time
    d = os.path.join(proj.workarea or "", ".hook-state", "sessions")
    out = []
    try:
        for f in os.listdir(d):
            if f.endswith(".json"):
                rec = json.load(open(os.path.join(d, f)))
                if time.time() - float(rec.get("last_seen", 0)) <= within:
                    out.append(rec)
    except Exception:
        pass
    return out


def cmd_routing(home, args):
    sub = args[0] if args else "show"
    proj = Project(home)
    rm = os.path.join(proj.hooks, "route_model.py")
    if sub == "show":
        sys.exit(run([PY, rm, "--print"], cwd=proj.root, env=proj.env()).returncode)
    if sub == "check":
        sys.exit(run([PY, rm, "--check"], cwd=proj.root, env=proj.env()).returncode)
    if sub == "resolve":
        if len(args) < 2:
            die("usage: ks routing resolve <agent-name>")
        sys.exit(run([PY, rm, "--resolve", args[1]], cwd=proj.root, env=proj.env()).returncode)
    if sub == "use":
        refuse_if_busy(proj, "routing use", args)
        path = os.path.join(proj.root, ".agents", "models.toml")
        text = open(path, encoding="utf-8").read()
        lines = [l for l in text.splitlines(keepends=True) if not re.match(r'^\s*selected\s*=', l)]
        if "--clear" in args:
            open(path, "w", encoding="utf-8").write("".join(lines))
            print("routing selection cleared (automatic: TKSFW_ROUTING → provider match → [routing.default])")
        else:
            if len(args) < 2:
                die("usage: ks routing use <table> | use --clear")
            table = next(a for a in args[1:] if not a.startswith("--"))
            if not re.search(rf'^\[routing\.{re.escape(table)}\]', text, re.M):
                die(f"no [routing.{table}] table in {path}")
            ins = f'selected = "{table}"                # pinned by `ks routing use` (`ks routing use --clear` to unpin)\n'
            for i, l in enumerate(lines):
                if re.match(r'^\s*schema\s*=', l):
                    lines.insert(i + 1, ins)
                    break
            else:
                lines.insert(0, ins)
            open(path, "w", encoding="utf-8").write("".join(lines))
            print(f"routing pinned to [routing.{table}] — log it in changes.yaml (Layer: METHOD)")
        rc = run([PY, rm, "--check"], cwd=proj.root, env=proj.env()).returncode
        if rc == 0:
            effect("spawn")
        sys.exit(rc)
    die("usage: ks routing show | check | resolve <agent> | use <table> | use --clear")


HIL_KEYS = {"impact": ["VERY LOW", "LOW", "MEDIUM", "HIGH", "VERY HIGH"],
            "reversibility": ["TRIVIAL", "EASY", "MEDIUM", "HARD", "VERY HARD"],
            "logic": ["and", "or"], "mode": ["enforce", "advisory"]}


def hil_read(proj):
    sys.path.insert(0, os.path.dirname(proj.asset("yaml-log-entry", "validate_yaml_log.py")))
    import validate_yaml_log as V
    return V.hil_policy(os.path.join(proj.root, ".agents", "workarea", "decisions.yaml")), V


def cmd_hil(home, args):
    """ks hil show | set [--impact L] [--reversibility L] [--logic and|or] [--mode enforce|advisory]"""
    sub = args[0] if args else "show"
    proj = Project(home)
    pol, V = hil_read(proj)
    if sub == "show":
        print(f"HIL threshold: {V.hil_describe(pol)}")
        for k in ("impact", "reversibility", "logic", "mode"):
            print(f"  {k} = {pol[k]}")
        print("  rule: AGENTS.md § Human in the Loop — at/above threshold: ConfirmationType OPERATOR; Workers leave it OPEN")
        sys.exit(0)
    if sub == "set":
        new = dict(pol)
        it = iter(args[1:])
        for a in it:
            key = a[2:]
            if key not in HIL_KEYS:
                die(f"usage: {cmd_hil.__doc__}")
            val = next(it, None)
            if val is None:
                die(f"--{key} needs a value: {HIL_KEYS[key]}")
            val = val.upper() if key in ("impact", "reversibility") else val.lower()
            if val not in HIL_KEYS[key]:
                die(f"--{key}: {val!r} not in {HIL_KEYS[key]}")
            new[key] = val
        if new == pol:
            print(f"HIL threshold unchanged: {V.hil_describe(pol)}")
            sys.exit(0)
        path = os.path.join(proj.root, ".agents", "models.toml")
        text = open(path, encoding="utf-8").read()
        block = ('[hil]                            # Human in the Loop threshold (AGENTS.md § Human in the Loop) — `ks hil show|set`\n'
                 f'impact = "{new["impact"]}"\n'
                 f'reversibility = "{new["reversibility"]}"\n'
                 f'logic = "{new["logic"]}"\n'
                 f'mode = "{new["mode"]}"\n')
        m = re.search(r'^\[hil\][^\n]*\n(?:(?!\[)[^\n]*\n?)*', text, re.M)
        if m:
            text = text[:m.start()] + block + ("\n" if not text[m.end():].startswith("\n") and text[m.end():] else "") + text[m.end():]
        else:
            text = text.rstrip("\n") + "\n\n" + block
        open(path, "w", encoding="utf-8").write(text)
        import tomllib
        with open(path, "rb") as fh:
            tomllib.load(fh)                                # must still parse
        print(f"HIL threshold: {V.hil_describe(new)} (was {V.hil_describe(pol)})")
        effect("decision")
        sys.exit(0)
    die(f"usage: {cmd_hil.__doc__}")


