def cmd_doctor(home, args):
    fails, warns = 0, 0
    findings = []
    as_json = "--json" in args

    def emit(kind, msg):
        text, _sep, hint = msg.partition(" — ")
        findings.append({"section": findings_section[0], "status": kind, "text": text, "hint": hint or None})
        if not as_json:
            ui.finding(kind, text, hint or None)

    def ok(msg):
        emit("ok", msg)

    def warn(msg):
        nonlocal warns
        warns += 1
        emit("warn", msg)

    def fail(msg):
        nonlocal fails
        fails += 1
        emit("fail", msg)

    findings_section = [""]

    def section(title, tail=""):
