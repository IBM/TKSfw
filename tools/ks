#!/usr/bin/env python3
"""ks — the TKSfw command line (one front door for every framework operation).

    ks self install | setup | version | home      put ks on PATH; one-shot user setup; version / home
    ks operator set <name> | show                 per-user ~/.config/tksfw/user.toml
    ks project init [dir] [--full] | update [dir] | enable | disable | status | drift [--json]
    ks project reset [--archive [--label L]] [--keep-agents] [--registry] [--dry-run] [--yes] [--force]
    ks routing list | show | check | resolve <agent> | use <table> | use --clear
    ks hil show | set [--impact L] [--reversibility L] [--logic and|or] [--mode enforce|advisory]
    ks layers resolve [--archetype P] [--spec P] [--json] | pin --archetype P | --spec P | --clear | journal | section
    ks ledger check | find <id> [--refs] [--json] | digest [--task T] [--agent A] [--json]
              | export all|<kinds> [--out F] [--archive] [--csv DIR]
              | archive-plan [--dry-run] | archive <ledger|all> --before YYYY-MM-DD [--dry-run]
    ks harness sync [--check] | retrust [--ack]
    ks doctor                                     installation integrity (user-level + project)
    ks dev build | test | release <version>       repository checkout only
    ks help [<command>]                           this list, or the full guide for one command

Global options: --plain (one record per line: no header, colour, symbols or padding — for scripts, hooks and the
model) · --json where a structure exists · --no-color / --color (NO_COLOR and TERM=dumb honoured) · --ascii.
Colour and symbols are on only when stdout is a TTY.

ks is a thin dispatcher: every operation is an existing framework script (hooks, skill assets,
tools/new_project.py); ks only resolves WHERE they are and adds status/doctor/retrust/drift views.
Standard library only, Python ≥ 3.11 (the same dependency as the hooks).

Framework home resolution: $TKSFW_HOME → `home = "…"` in ~/.config/tksfw/user.toml → this script's
own location (tools/ks in a checkout, bin/ks in the plugin) → harness plugin directories.
Project resolution: $TKSFW_PROJECT_ROOT → nearest ancestor of cwd with .agents/.tksfw.json.
"""
import sys
sys.dont_write_bytecode = True
import os
import re
import json
import shutil
import hashlib
import platform
import subprocess
import signal

try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)      # `ks … | head` must not trace
except Exception:
    pass

PY = sys.executable
HERE = os.path.dirname(os.path.realpath(__file__))
CONFIG_DIR = os.environ.get("TKSFW_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".config", "tksfw")
USER_TOML = os.path.join(CONFIG_DIR, "user.toml")
TRUST_JSON = os.path.join(CONFIG_DIR, "trust.json")


# ----------------------------------------------------------------------------- output (3.7.0 — one renderer)
# Colour is on only when stdout is a TTY, NO_COLOR is unset, TERM != dumb and neither --no-color nor --plain was
# given (--color forces it). Symbols fall back to ASCII when the stream is not UTF-8 or --ascii is given. --plain
# prints one record per line (no header, colour, symbols or padding) for scripts, hooks and the model. Colour marks
# meaning: green ok/armed, yellow needs attention, red refused, cyan = identifiers you can type, dim = context.
class UI:
    ESC = {"b": "\033[1m", "d": "\033[2m", "g": "\033[32m", "y": "\033[33m", "r": "\033[31m", "c": "\033[36m", "/": "\033[0m"}
    SYM = {"ok": ("✓", "OK"), "on": ("●", "ON"), "warn": ("!", "WARN"), "fail": ("✗", "FAIL"), "arrow": ("→", "->"),
           "dot": ("·", "-"), "back": ("←", "<-"), "ge": ("≥", ">=")}

    def __init__(self, argv):
        self.plain = "--plain" in argv
        self.ascii = "--ascii" in argv
        tty = hasattr(sys.stdout, "isatty") and sys.stdout.isatty()
        self.color = (tty and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"
                      and "--no-color" not in argv and not self.plain) or ("--color" in argv and not self.plain)
        enc = (getattr(sys.stdout, "encoding", None) or "").lower().replace("-", "")
        if not self.ascii and "utf8" not in enc:
            self.ascii = True
        if self.plain:
            self.ascii = True
        self.width = shutil.get_terminal_size((100, 24)).columns if tty else 100
        self._kv = []

    # -- primitives
    def c(self, text, style):
        """Colour `text` with style letters (b d g y r c); no-op without colour."""
        if not self.color or not text:
            return text
        return "".join(self.ESC[ch] for ch in style) + text + self.ESC["/"]

    def sym(self, name):
        u, a = self.SYM[name]
        return a if self.ascii else u

    def mark(self, kind):
        col = {"ok": "g", "on": "g", "warn": "y", "fail": "r"}[kind]
        return self.c(self.sym(kind), col)

    def dot(self):
        return self.c(f" {self.sym('dot')} ", "d")

    def header(self, verb="", project=None, path=None):
        """`ks <version> · TKSfw · <verb>` with the project name on the right and its path below. Skipped in --plain."""
        if self.plain:
            return
        left = self.c(f"ks {Home.version_of(HERE)}", "b") + self.dot() + "TKSfw" + (self.dot() + verb if verb else "")
        raw_left = f"ks {Home.version_of(HERE)} {self.sym('dot')} TKSfw" + (f" {self.sym('dot')} {verb}" if verb else "")
        if project:
            pad = max(2, min(self.width, 100) - len(raw_left) - len(project))
            left += " " * pad + self.c(project, "b")
        print(left)
        if path:
            print(self.c(path, "d"))
        print()

    def section(self, title, tail=""):
        if self.plain:
            if tail:
                print(f"{title.lower().replace(' ', '_')} {self.strip(tail)}")
            return
        print(self.c(title.upper(), "b") + (("  " + tail) if tail else ""))

    def kv(self, key, value, status=None, indent=2):
        """Queue a key/value row; `status` = (kind|None, text) lands in a right column at flush()."""
        self._kv.append((key, value, status, indent))

    def flush(self):
        """Print queued kv rows: keys padded, values padded, status column aligned; a status that does not
        fit the terminal moves under its row. In --plain: `key value status`."""
        rows, self._kv = self._kv, []
        if not rows:
            return
        if self.plain:
            last = ""
            for k, v, st, _i in rows:
                k = k or last
                last = k
                val = re.sub(r"\s+", " ", self.strip(v)).strip()
                stx = re.sub(r"\s+", " ", self.strip(st[1])).strip() if st else ""
                print(" ".join(x for x in (k, val, stx) if x))
            return
        kw = max(len(k) for k, *_ in rows)
        vw = max(len(self.strip(v)) for _k, v, *_ in rows)
        col = min(vw + 4, max(40, self.width - 30))
        for k, v, st, ind in rows:
            line = " " * ind + k.ljust(kw + 2) + v
            if st:
                kind, text = st
                cell = ((self.mark(kind) + " ") if kind else "") + text
                raw = len(self.strip(v))
                if ind + kw + 2 + col + len(self.strip(text)) + 2 <= self.width and raw <= col - 2:
                    line += " " * (col - raw) + cell
                else:
                    line += "\n" + " " * (ind + kw + 2) + cell
            print(line)

    def table(self, headers, rows, indent=2, trailer=None):
        """Left-aligned columns, dim header row. `trailer(row)` may add free text after the last column."""
        if self.plain:
            for r in rows:
                print(" ".join(f"{h}={self.strip(str(c))}" if " " in self.strip(str(c)) else self.strip(str(c)) for h, c in zip(headers, r)))
            return
        w = [max(len(self.strip(str(r[i]))) for r in rows + [headers]) for i in range(len(headers))]
        print(" " * indent + self.c("  ".join(str(h).ljust(w[i]) for i, h in enumerate(headers)).rstrip(), "d"))
        for r in rows:
            cells = [str(c) + " " * (w[i] - len(self.strip(str(c)))) for i, c in enumerate(r)]
            line = " " * indent + "  ".join(cells).rstrip()
            extra = trailer(r) if trailer else ""
            print(line + ("  " + extra if extra else ""))

    def finding(self, kind, text, hint=None, indent=2):
        """`✓ text`, `! text → hint`, `✗ text → hint` — hint (a command, cyan) aligned or wrapped under."""
        if self.plain:
            print(f"{self.sym(kind)} {self.strip(text)}" + (f" {self.sym('arrow')} {self.strip(hint)}" if hint else ""))
            return
        line = " " * indent + self.mark(kind) + " " + self.fmt(text)
        if hint:
            h = self.c(self.sym("arrow"), "d") + " " + self.fmt(hint)
            raw = indent + 2 + len(self.strip(text))
            if raw + 3 + len(self.strip(hint)) + 2 <= self.width:
                line += "   " + h
            else:
                line += "\n" + " " * (indent + 2) + h
        print(line)

    def blank(self):
        if not self.plain:
            print()

    def hint(self, text, indent=0):
        print(" " * indent + self.c(self.sym("arrow"), "d") + " " + self.fmt(text))

    def cmd(self, text):
        return self.c(text, "c")

    def fmt(self, text):
        """`code` spans → cyan (backticks dropped when colour is on; kept otherwise for legibility)."""
        if self.plain or not self.color:
            return text
        return re.sub(r"`([^`]+)`", lambda m: self.c(m.group(1), "c"), text)

    def ident(self, text):
        return self.c(text, "c")

    def dim(self, text):
        return self.c(text, "d")

    def bold(self, text):
        return self.c(text, "b")

    @staticmethod
    def strip(text):
        return re.sub(r"\033\[[0-9;]*m", "", str(text))


UI_FLAGS = ("--plain", "--no-color", "--color", "--ascii")
ui = None                                                 # set in main() once the flags are known


def die(msg, rc=1, hint=None):
    """Refusal / error: `✗ <what> — <fix>` on stderr; `hint` (a command) goes after the dash."""
    m = msg.rstrip("\n")
    if ui and not ui.plain:
        head, _sep, tail = m.partition(" — ")
        m = ui.mark("fail") + " " + head + ((" " + ui.dim("—") + " " + tail) if tail else "")
        if hint:
            m += " " + ui.dim("—") + " " + ui.cmd(hint)
    elif hint:
        m += " -- " + hint
    sys.stderr.write(m + "\n")
    sys.exit(rc)


def run(cmd, cwd=None, env=None, check=False, capture=False):
    sys.stdout.flush()                                     # keep our lines before the child's
    r = subprocess.run(cmd, cwd=cwd, env=env, text=True, capture_output=capture)
    if check and r.returncode:
        sys.exit(r.returncode)
    return r


# ----------------------------------------------------------------------------- home
def user_toml():
    out = {}
    try:
        for line in open(USER_TOML, encoding="utf-8"):
            m = re.match(r'^\s*(\w+)\s*=\s*"([^"]*)"\s*(#.*)?$', line)
            if m:
                out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def home_kind(path):
    """'repo' (checkout: tools/ + template/), 'plugin' (bundle: hooks/ + skills/tksfw-init/assets/template) or None."""
    if not path or not os.path.isdir(path):
        return None
    if os.path.isdir(os.path.join(path, "template")) and os.path.isfile(os.path.join(path, "tools", "new_project.py")):
        return "repo"
    if os.path.isdir(os.path.join(path, "hooks")) and os.path.isdir(os.path.join(path, "skills", "tksfw-init", "assets", "template")):
        return "plugin"
    return None


def resolve_home(path):
    """`path` itself, or — when it is an unzipped bundle root (tksfw/ with plugins/tksfw inside) — the
    plugin inside it. Lets TKSFW_HOME or user.toml name the bundle folder, not a path four levels down."""
    if home_kind(path):
        return path
    inner = os.path.join(path or "", "plugins", "tksfw")
    if path and home_kind(inner) == "plugin":
        return inner
    return None


def candidate_homes():
    yield os.environ.get("TKSFW_HOME"), "TKSFW_HOME"
    yield user_toml().get("home"), "user.toml"
    yield os.path.dirname(HERE), "script location"
    codex_home = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
    for base in (os.path.join(codex_home, "plugins"), os.path.join(os.path.expanduser("~"), ".claude", "plugins")):
        if os.path.isdir(base):
            for root, dirs, _files in os.walk(base):
                if os.path.basename(root) == "tksfw" and home_kind(root) == "plugin":
                    yield root, base
                if root.count(os.sep) - base.count(os.sep) > 4:
                    dirs[:] = []


class Home:
    def __init__(self):
        self.path, self.how, self.kind = None, None, None
        for p, how in candidate_homes():
            p = resolve_home(p)
            k = home_kind(p)
            if k:
                self.path, self.how, self.kind = os.path.abspath(p), how, k
                break
        if not self.path:
            die("TKSfw home not found — set TKSFW_HOME, or `ks self install` from a checkout / plugin bundle")
        if self.kind == "repo":
            self.template = os.path.join(self.path, "template")
            self.new_project = os.path.join(self.path, "tools", "new_project.py")
            self.hooks = os.path.join(self.template, ".agents", "hooks")
            self.skills = os.path.join(self.template, ".agents", "skills")
            self.version = open(os.path.join(self.path, "VERSION")).read().strip()
        else:
            assets = os.path.join(self.path, "skills", "tksfw-init", "assets")
            self.template = os.path.join(assets, "template")
            self.new_project = os.path.join(assets, "new_project.py")
            self.hooks = os.path.join(self.path, "hooks")
            self.skills = os.path.join(self.path, "skills")
            self.version = open(os.path.join(assets, "VERSION")).read().strip()

    def asset(self, skill, name):
        return os.path.join(self.skills, skill, "assets", name)

    _ver = None

    @classmethod
    def version_of(cls, here):
        """Version of the ks script's own home (checkout: ../VERSION; plugin: ../skills/tksfw-init/assets/VERSION)."""
        if cls._ver is None:
            cls._ver = "?"
            for cand in (os.path.join(here, "..", "VERSION"), os.path.join(here, "..", "skills", "tksfw-init", "assets", "VERSION")):
                try:
                    cls._ver = open(cand).read().strip()
                    break
                except OSError:
                    pass
        return cls._ver


# ----------------------------------------------------------------------------- project
class Project:
    def __init__(self, home, path=None, required=True):
        p = path or os.environ.get("TKSFW_PROJECT_ROOT")
        if not p:
            cur = os.getcwd()
            while True:
                if os.path.isfile(os.path.join(cur, ".agents", ".tksfw.json")):
                    p = cur
                    break
                parent = os.path.dirname(cur)
                if parent == cur:
                    break
                cur = parent
        self.root = os.path.abspath(p) if p else None
        if not self.root and required:
            die("not inside a TKSfw project (no .agents/.tksfw.json upward from cwd; set TKSFW_PROJECT_ROOT)")
        self.manifest = {}
        if self.root:
            try:
                self.manifest = json.load(open(os.path.join(self.root, ".agents", ".tksfw.json")))
            except Exception:
                self.manifest = {}
        # in-project tooling (full mode) is the pinned version and wins over the home copy
        self.hooks = os.path.join(self.root, ".agents", "hooks") if self.root and os.path.isfile(os.path.join(self.root, ".agents", "hooks", "hooks.json")) else home.hooks
        self.skills = os.path.join(self.root, ".agents", "skills") if self.root and os.path.isdir(os.path.join(self.root, ".agents", "skills", "yaml-log-entry")) else home.skills
        self.workarea = os.path.join(self.root, ".agents", "workarea") if self.root else None

    def config_toml(self):
        """`.agents/config.toml` (3.0.0), or the legacy `.agents/models.toml` when only that exists."""
        new = os.path.join(self.root, ".agents", "config.toml")
        old = os.path.join(self.root, ".agents", "models.toml")
        return old if (not os.path.isfile(new) and os.path.isfile(old)) else new

    def env(self):
        e = dict(os.environ)
        if self.root:
            e["TKSFW_PROJECT_ROOT"] = self.root
        return e

    def asset(self, skill, name):
        return os.path.join(self.skills, skill, "assets", name)


# ----------------------------------------------------------------------------- effects / safety
EFFECT = {
    "spawn": "takes effect at the next subagent spawn (no restart); the model is told at its next prompt",
    "prompt": "takes effect immediately; the model is told at its next prompt",
    "session": "takes effect at the next session: restart the harness; Codex → /hooks re-trust, then `ks harness retrust --ack`",
    "files": "files changed now; the session sees them at its next prompt, STATE.md at its next turn end",
    "decision": "applies to the next decision entry (no restart); the model is told at its next prompt; STATE.md re-marks pending decisions at its next turn end",
}


def effect(kind):
    ui.hint(EFFECT[kind])


def live_subagents(proj):
    """Live subagents in this project (all sessions) from .hook-state/subagents.json."""
    import time, glob
    out = []
    for p in glob.glob(os.path.join(proj.workarea or "", ".hook-state", "hosts", "*", "subagents.json")) + \
             [os.path.join(proj.workarea or "", ".hook-state", "subagents.json")]:
        try:
            live = json.load(open(p)).get("live", {})
            out += [e for e in live.values() if time.time() - float(e.get("ts", 0)) < 4 * 3600]
        except Exception:
            pass
    return out


def refuse_if_busy(proj, what, args, sessions=False):
    if "--force" in args:
        return
    live = live_subagents(proj)
    if live:
        die(f"{what}: {len(live)} subagent(s) are running in this project — wait for them to return, or", hint=f"ks {what} --force")
    if sessions:
        act = active_sessions(proj)
        if act:
            die(f"{what}: {len(act)} session(s) active on this project (" + ", ".join(a['token'] for a in act)
                + ") — finish them first, `ks project sessions close` the ones you know are closed, or", hint=f"ks {what} --force")


def project_name(proj, layers=None):
    """Display name: frontmatter `title` of the spec, else of the archetype, else the folder name."""
    if layers is None and proj.root and getattr(proj, "hooks", None):
        try:
            r = run([PY, os.path.join(proj.hooks, "layers.py"), "resolve", "--json"], cwd=proj.root, env=proj.env(), capture=True)
            layers = json.loads(r.stdout).get("layers", [])
        except Exception:
            layers = []
    for key in ("spec", "archetype"):
        for e in (layers or []):
            if e.get("layer") == key and e.get("title"):
                return e["title"]
    return os.path.basename(proj.root.rstrip(os.sep)) or proj.root


def short_home(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home) else path


# ----------------------------------------------------------------------------- sessions (3.4.0)
def _host():
    import socket
    return re.sub(r"[^A-Za-z0-9._-]", "_", os.environ.get("TKSFW_HOST") or socket.gethostname().split(".")[0] or "host")


def _operator_name(home):
    r = run([PY, home.new_project, "--show-operator"], capture=True)
    m = re.search(r"operator:\s*(.*?)\s+\(source", r.stdout or "")
    return m.group(1).strip() if m else ""


def session_arg(args):
    """('present', token_or_None) for `--session [token]`; ('absent', None) otherwise."""
    if "--session" not in args:
        return "absent", None
    i = args.index("--session")
    nxt = args[i + 1] if i + 1 < len(args) else None
    tok = nxt if nxt and not nxt.startswith("--") and re.fullmatch(r"[0-9A-Za-z]{8}", nxt) else None
    return "present", tok


def current_session(proj, home, sessions=None):
    """(record, how) for the session `ks` is running in: $TKSFW_SESSION (exported by the SessionStart hook
    through CLAUDE_ENV_FILE, or set by hand) → the only active session on this host by this operator →
    (None, reason)."""
    sessions = active_sessions(proj) if sessions is None else sessions
    env_tok = os.environ.get("TKSFW_SESSION")
    if env_tok:
        for s in sessions:
            if s.get("token") == env_tok:
                return s, "TKSFW_SESSION"
        return None, f"TKSFW_SESSION={env_tok} names no active session"
    me = _operator_name(home)
    mine = [s for s in sessions if s.get("host") == _host() and (not me or s.get("operator") == me)]
    if len(mine) == 1:
        return mine[0], "only session on this host by you"
    if not sessions:
        return None, "no active session in this project"
    return None, "several candidates — pass the token: " + ", ".join(f"{s['token']} ({s.get('harness', '?')}, {s.get('operator') or '?'}@{s.get('host') or '?'})" for s in sessions)


def resolve_session(proj, home, args, required=True):
    """The session record addressed by `--session [token]`, or None when the flag is absent."""
    mode, tok = session_arg(args)
    if mode == "absent":
        return None
    sessions = active_sessions(proj)
    if tok:
        for s in sessions:
            if s["token"] == tok:
                return s
        die(f"--session {tok}: no active session with that token (ks project status lists them)")
    rec, how = current_session(proj, home, sessions)
    if rec is None:
        die(f"--session: cannot tell which session is yours — {how}")
    return rec


def write_session(proj, rec):
    p = os.path.join(proj.workarea, ".hook-state", "sessions", rec["token"] + ".json")
    tmp = p + ".tmp"
    json.dump(rec, open(tmp, "w", encoding="utf-8"), indent=1)
    os.replace(tmp, p)


def _ago(ts):
    import time
    d = max(0, int(time.time() - float(ts or 0)))
    return f"{d}s ago" if d < 90 else f"{d // 60} min ago" if d < 5400 else f"{d // 3600} h ago"


def sessions_data(proj, home):
    """(active rows, ended-recently count, me-token, how) for status/sessions views and --json."""
    import time
    sess = sorted(active_sessions(proj), key=lambda s: -float(s.get("last_seen", 0)))
    ended = [s for s in all_sessions(proj) if s.get("ended") and time.time() - float(s["ended"]) <= 3 * 3600]
    me, how = current_session(proj, home, sess) if sess else (None, None)
    return sess, len(ended), me, how


def print_sessions(proj, home, section=True):
    import time
    sess, n_ended, me, how = sessions_data(proj, home)
    tail = f"{len(sess)} active" + (ui.dim(f" {ui.sym('dot')} {n_ended} ended in the last 3 h") if n_ended else "")
    if section:
        ui.section("sessions", tail)
    else:
        print(tail)
    if ui.plain:
        for s_ in sess:
            print(f"session {s_['token']} harness={s_.get('harness') or '?'} operator=\"{s_.get('operator') or '?'}\" host={s_.get('host') or '?'} "
                  f"started={time.strftime('%Y-%m-%dT%H:%M', time.localtime(float(s_.get('started', 0))))} last_seen={int(time.time() - float(s_.get('last_seen', 0)))} "
                  f"routing={s_.get('routing') or 'project'}" + (" current=true" if me and s_['token'] == me['token'] else ""))
        return
    if not sess:
        print("  " + ui.dim("none — a session counts as active until its harness ends it, or for 30 min after its last heartbeat"))
        return
    rows = []
    for s_ in sess:
        rows.append((ui.ident(s_["token"]), s_.get("harness") or "?", (s_.get("operator") or "?")[:22], s_.get("host") or "?",
                     time.strftime("%m-%d %H:%M", time.localtime(float(s_.get("started", 0)))), _ago(s_.get("last_seen")),
                     (ui.ident(s_["routing"]) + ui.dim(" (session)")) if s_.get("routing") else "project"))
    def trailer(r):
        tok = ui.strip(r[0])
        if me and tok == me["token"]:
            return ui.c(ui.sym("back") + (" this session" if how == "TKSFW_SESSION" else " probably yours"), "g") + ui.dim(f" ({how})")
        return ""
    ui.table(("token", "harness", "operator", "host", "started", "last seen", "routing"), rows, trailer=trailer)
    if any(time.time() - float(s_.get("last_seen", 0)) > 600 for s_ in sess):
        ui.hint(ui.dim("a session you closed but still listed sent no SessionEnd:") + " " + ui.cmd("ks project sessions close <token>") + ui.dim(" or ") + ui.cmd("--stale"), indent=2)


