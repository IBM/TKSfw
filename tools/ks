def help_lines(text):
    """Light formatting for the per-verb guides: ALL-CAPS heading lines bold, `ks …` command lines cyan up to the
    double space, `code` spans cyan."""
    out = []
    for line in text.rstrip("\n").splitlines():
        if re.fullmatch(r"[A-Z][A-Z /–-]{2,}[A-Z](\s*\(.*\))?", line.strip()) and not line.startswith(" "):
            out.append(ui.bold(line))
        elif line.startswith("  ks "):
            cmd_part, sep, rest = line[2:].partition("  ")
            out.append("  " + ui.cmd(cmd_part) + (sep + ui.fmt(rest) if sep else ""))
        elif line.startswith("  ! "):
            out.append("  " + ui.mark("warn") + " " + ui.fmt(line[4:]))
        else:
            out.append(ui.fmt(line))
    return out


def cmd_help(home, args):
    if not args:
        if ui.plain:
            print(__doc__)
            sys.exit(0)
        ui.header("", None)
        print(ui.bold("ks") + " " + ui.dim("— one front door for every framework operation"))
        print()
        ui.section("usage")
        print(f"  ks {ui.cmd('<verb>')} [<action>] [options]")
        print()
        ui.section("examples")
        ex = [("ks project init ~/work/acme", "arm a folder " + ui.dim("(plugin mode)")),
              ("ks routing use openrouter --session", "switch this session's models only"),
              ("ks doctor", "check the installation and this project")]
        w = max(len(c) for c, _ in ex)
        for c, d in ex:
            print("  " + ui.cmd(c) + " " * (w - len(c) + 4) + d)
        print()
        ui.section("verbs")
        w = max(len(a) for _v, a, _d in VERBS)
        for v, a, d in VERBS:
            print("  " + ui.cmd(v.ljust(10)) + "  " + a + ((" " * (w - len(a) + 4) + ui.dim(d)) if d else ""))
        print()
        ui.section("options")
        for f, d in (("--plain", "one record per line, no header, colour or symbols " + ui.dim("(for scripts, hooks and the model)")),
                     ("--json", "structured output where it exists " + ui.dim("(status, sessions, doctor, drift, layers, ledger)")),
                     ("--no-color", "disable colour " + ui.dim("(NO_COLOR and TERM=dumb are honoured; --color forces it)")),
                     ("--ascii", "ASCII marks OK WARN FAIL -> " + ui.dim("(automatic when the stream is not UTF-8)")),
                     ("-h, --help", "")):
            print("  " + ui.cmd(f.ljust(12)) + "  " + d)
        print()
        print(ui.cmd("ks help <verb>") + " for the full guide of one verb.  " + ui.dim("Standard library only, Python ≥ 3.11."))
        sys.exit(0)
    key = args[0].lstrip("-")
    if key not in HELP:
        die(f"no help for {key!r}", hint="ks help  (verbs: " + ", ".join(k for k in HELP if k != "help") + ")")
    print("\n".join(help_lines(HELP[key])))
    sys.exit(0)


