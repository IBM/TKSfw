def sync_conflicts(proj):
    """Ledger-like files with non-canonical names in the workarea (Box/Dropbox/OneDrive collision copies)."""
    shard = re.compile(r"^(changes|lessons|handoffs|events|decisions)\.([0-9A-Za-z]{8})\.yaml$")
    canon = {"changes.yaml", "lessons.yaml", "handoffs.yaml", "events.yaml", "decisions.yaml", "deliverables.yaml",
             "tasks.md", "tasks-archive.md", "STATE.md"}
    like = re.compile(r"^(changes|lessons|handoffs|events|decisions|deliverables|tasks)[ .(_-].*")
    out = []
    try:
        for n in sorted(os.listdir(proj.workarea)):
            if os.path.isfile(os.path.join(proj.workarea, n)) and n not in canon and not shard.match(n) and like.match(n):
                out.append(n)
    except Exception:
        pass
    return out


def hook_hashes(hooks_dir):
    out = {}
    for f in sorted(os.listdir(hooks_dir)):
        if f.endswith((".py", ".json")):
            out[f] = hashlib.sha256(open(os.path.join(hooks_dir, f), "rb").read()).hexdigest()
    return out


def cmd_harness(home, args):
    sub = args[0] if args else "retrust"
    proj = Project(home, required=(sub == "sync"))
    if sub == "sync":
        sync = os.path.join(proj.hooks, "sync_harness.py")
        if not os.path.isfile(sync):
            die("plugin-mode project: nothing to sync (hooks and skills come from the plugin)")
        rc = run([PY, sync, *args[1:]], cwd=proj.root, env=proj.env()).returncode
        if rc == 0 and "--check" not in args:
            effect("session")
        sys.exit(rc)
    if sub == "retrust":
        hooks_dir = proj.hooks if proj.root else home.hooks
        cur = hook_hashes(hooks_dir)
        trust = {}
        try:
            trust = json.load(open(TRUST_JSON))
        except Exception:
            pass
        prev = trust.get(hooks_dir, {})
        changed = sorted(f for f in cur if prev.get(f) != cur[f])
        if "--ack" in args:
            trust[hooks_dir] = cur
            os.makedirs(CONFIG_DIR, exist_ok=True)
            json.dump(trust, open(TRUST_JSON, "w"), indent=1)
            print(f"recorded {len(cur)} hook file hashes for {hooks_dir}")
            return
        print(f"hooks: {hooks_dir}")
        if not prev:
            print("no trust record yet — after trusting the hooks in Codex (/hooks → trust), run `ks harness retrust --ack`")
            sys.exit(1)
        if changed:
            print("RE-TRUST NEEDED — hook files changed since the last acknowledgement:")
            for f in changed:
                print("  -", f)
            print("Codex: open the project, run /hooks, review and trust; then `ks harness retrust --ack`.\n"
                  "Claude Code: no trust step (hooks load from settings/plugin).")
            sys.exit(1)
        print("no change since last acknowledgement")
        return
    die("usage: ks harness sync [--check] | retrust [--ack]")


def cmd_doctor(home, args):
    fails, warns = 0, 0

    def ok(msg):
        print("  ok   ", msg)

    def warn(msg):
        nonlocal warns
        warns += 1
        print("  WARN ", msg)

    def fail(msg):
        nonlocal fails
        fails += 1
        print("  FAIL ", msg)

    print("== runtime")
    v = sys.version_info
    (ok if v >= (3, 11) else fail)(f"python {platform.python_version()} at {PY}" + ("" if v >= (3, 11) else " — 3.11+ required (tomllib)"))
    (ok if shutil.which("git") else warn)("git " + (run(["git", "--version"], capture=True).stdout.strip() if shutil.which("git") else "not found (worktrees unavailable)"))
    print("== framework home")
    ok(f"{home.kind} {home.version} at {home.path} (via {home.how})")
    cfg = user_toml()
    (ok if cfg.get("home") else warn)(f"user.toml home = {cfg.get('home') or 'not recorded — `ks self install`'}")
    r = run([PY, home.new_project, "--show-operator"], capture=True)
    if r.returncode:
        fail("operator not configured — `ks operator set \"<name>\"` (getting-started step 5)")
    elif "source: git" in r.stdout:
        warn(r.stdout.strip() + " — set the item: `ks operator set`")
    else:
        ok(r.stdout.strip())
    print("== harnesses (user level)")
    codex_home = os.environ.get("CODEX_HOME") or os.path.join(os.path.expanduser("~"), ".codex")
    mk = os.path.join(os.path.expanduser("~"), ".agents", "plugins", "marketplace.json")
    (ok if os.path.isfile(mk) else warn)(f"Codex personal marketplace: {mk if os.path.isfile(mk) else 'absent — `codex plugin marketplace add <home>` (getting-started step 3)'}")
    ccfg = os.path.join(codex_home, "config.toml")
    if os.path.isfile(ccfg):
        t = open(ccfg, encoding="utf-8").read()
        (ok if "hooks" in t else warn)(f"Codex config {ccfg}: " + ("mentions hooks" if "hooks" in t else "no hooks feature flag found — hooks may be disabled"))
    else:
        warn(f"Codex config not found at {ccfg}")
    cl = os.path.join(os.path.expanduser("~"), ".claude", "settings.json")
    if os.path.isfile(cl):
        try:
            cs = json.load(open(cl))
            ep = (cs.get("enabledPlugins") or {})
            state = ep.get("tksfw@tksfw")
            (ok if state is not False else fail)(f"Claude Code user settings: tksfw@tksfw = {state if state is not None else 'not listed'}")
            if cs.get("disableAllHooks"):
                fail("Claude Code user settings: disableAllHooks = true")
        except Exception:
            warn(f"Claude Code settings unreadable: {cl}")
    else:
        warn("Claude Code user settings not found (~/.claude/settings.json) — `claude plugin install tksfw@tksfw --scope user` (getting-started step 3)")
    for target in (os.path.join(codex_home, "AGENTS.md"), os.path.join(os.path.expanduser("~"), ".claude", "CLAUDE.md")):
        present = os.path.isfile(target) and STANZA_MARK in open(target, encoding="utf-8", errors="replace").read()
        (ok if present else warn)(f"bootstrap stanza in {target}: {'present' if present else 'absent — `ks self setup` (getting-started step 4)'}")
    proj = Project(home, required=False)
    if proj.root:
        print(f"== project {proj.root}")
        m = proj.manifest
        (ok if m.get("enabled", True) is not False else warn)(f"armed: {m.get('enabled', True) is not False}")
        pv, iv = str(m.get("version", "?")), home.version
        (ok if pv.split(".")[:2] == iv.split(".")[:2] else warn)(f"version project {pv} / installed {iv}" + ("" if pv == iv else " — `ks project update`"))
        d = run([PY, home.new_project, proj.root, "--drift", "--json"], capture=True)
        try:
            dj = json.loads(d.stdout)
            (ok if not dj.get("drift") else warn)(f"drift: outdated {len(dj['outdated'])}, edited {len(dj['edited'])}, missing {len(dj['missing'])}")
        except Exception:
            warn("drift report unavailable")
        try:
            pol, V = hil_read(proj)
            ok(f"HIL threshold: {V.hil_describe(pol)}")
        except Exception as e:
            warn(f"HIL threshold unreadable: {e}")
        if "/Library/CloudStorage/" in proj.root or "/Box/" in proj.root or "/Dropbox/" in proj.root:
            warn("project lives in a cloud-synced folder — mtimes are unreliable (hooks hash content) and git worktrees are not recommended")
        for sf in (".claude/settings.json", ".claude/settings.local.json"):
            p = os.path.join(proj.root, sf)
            if os.path.isfile(p):
                try:
                    cs = json.load(open(p))
                    if (cs.get("enabledPlugins") or {}).get("tksfw@tksfw") is False:
                        warn(f"{sf}: tksfw@tksfw disabled here (hard off)")
                    if cs.get("disableAllHooks"):
                        fail(f"{sf}: disableAllHooks = true")
                except Exception:
                    warn(f"{sf} unreadable")
        full = os.path.isfile(os.path.join(proj.root, ".agents", "hooks", "hooks.json"))
        ok(f"mode: {'full (in-project hooks; the plugin yields)' if full else 'plugin (hooks from the plugin)'}")
        if full:
            for mirror in (".codex/hooks.json", ".claude/settings.json"):
                (ok if os.path.isfile(os.path.join(proj.root, mirror)) else warn)(f"harness mirror {mirror}" + ("" if os.path.isfile(os.path.join(proj.root, mirror)) else " missing — `ks harness sync`"))
        rc = run([PY, os.path.join(proj.hooks, "route_model.py"), "--check"], cwd=proj.root, env=proj.env(), capture=True)
        (ok if rc.returncode == 0 else fail)("routing: " + rc.stdout.strip().splitlines()[0] if rc.stdout.strip() else "routing: no output")
        sess = active_sessions(proj)
        (ok if len(sess) <= 1 else warn)(f"active sessions: {len(sess)}" + ("" if len(sess) <= 1 else " — ledgers are partitioned per session; tasks.md has one plan-writer"))
        conf = sync_conflicts(proj)
        (ok if not conf else fail)("sync conflict copies: " + (", ".join(conf) + " — merge by hand into the canonical files, then delete" if conf else "none"))
        shards = [n for n in os.listdir(proj.workarea) if re.match(r"^(changes|lessons|handoffs|events|decisions)\.[0-9A-Za-z]{8}\.yaml$", n)] if os.path.isdir(proj.workarea) else []
        legacy = [n for n in ("changes.yaml", "lessons.yaml", "handoffs.yaml", "events.yaml", "decisions.yaml") if os.path.isfile(os.path.join(proj.workarea, n))]
        (ok if not legacy else warn)(f"ledger shards: {len(shards)}" + (f" · legacy unsuffixed (read-only): {', '.join(legacy)} — `ks ledger archive all --before <today>` folds them into the archive" if legacy else ""))
        cur = hook_hashes(proj.hooks)
        try:
            prev = json.load(open(TRUST_JSON)).get(proj.hooks, {})
        except Exception:
            prev = {}
        ch = [f for f in cur if prev.get(f) != cur[f]]
        (ok if prev and not ch else warn)("hook trust: " + ("acknowledged" if prev and not ch else f"{len(ch)} hook file(s) not acknowledged — Codex /hooks then `ks harness retrust --ack`"))
    else:
        print("== project: not inside a TKSfw project")
    print(f"\n{fails} FAIL · {warns} WARN")
    sys.exit(1 if fails else 0)


