def cmd_project(home, args):
    sub = args[0] if args else "status"
    rest = args[1:]
    if sub == "init":
        target = next((a for a in rest if not a.startswith("--")), os.getcwd())
        cmd = [PY, home.new_project, target] + ([] if "--full" in rest else ["--plugin-mode"])
        rc = run(cmd).returncode
        if rc == 0:
            try:
                print("Main session model (judge tier of the active routing table):")
                apply_main_model(Project(home, os.path.abspath(target)))
            except SystemExit:
                pass
        sys.exit(rc)
    if sub == "sessions":
        proj = Project(home)
        act = next((a for a in rest if not a.startswith("--")), "list")
        if act == "list":
            if "--json" in rest:
                sess, n_ended, me, how = sessions_data(proj, home)
                print(json.dumps({"active": [{k: v for k, v in s_.items() if not k.startswith("_")} | {"current": bool(me and s_["token"] == me["token"])} for s_ in sess], "ended_recently": n_ended}, indent=2))
                sys.exit(0)
            ui.header("sessions", project_name(proj), proj.root)
            print_sessions(proj, home)
            sys.exit(0)
        if act == "close":
            toks = [a for a in rest[1:] if not a.startswith("--")]
            if not toks and "--stale" not in rest and "--all" not in rest:
                die("ks project sessions close <token>… | --stale | --all")
            done = close_sessions(proj, tokens=toks or None, stale="--stale" in rest) if (toks or "--stale" in rest) \
                else close_sessions(proj)
            print(ui.mark("ok") + f" closed {len(done)} session record(s)" + ((" " + ui.dim(ui.sym("dot")) + " " + ", ".join(ui.ident(t) for t in done)) if done else ""))
            if toks and set(toks) - set(done):
                die("not found or already ended: " + ", ".join(sorted(set(toks) - set(done))))
            sys.exit(0)
        die(f"ks project sessions: unknown action {act!r} (list | close)")
    if sub in ("update", "enable", "disable", "drift"):
        target = next((a for a in rest if not a.startswith("--")), None)
        proj = Project(home, target)
        if sub == "update":
            refuse_if_busy(proj, "project update", rest, sessions=True)
        cmd = [PY, home.new_project, proj.root, "--" + sub] + (["--json"] if "--json" in rest else [])
        rc = run(cmd).returncode
