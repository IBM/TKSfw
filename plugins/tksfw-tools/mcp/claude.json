{
  "mcpServers": {
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server"],
      "env": { "PERPLEXITY_API_KEY": "${user_config.perplexity_api_key}" }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--isolated", "--output-dir", "${CLAUDE_PROJECT_DIR}/.playwright"]
    }
  }
}
