{
  "description": "Project method hooks (single source). Mirrored verbatim to .codex/hooks.json and into .claude/settings.json by `python3 .agents/hooks/sync_harness.py` (which also links skills into .claude/skills/) \u2014 edit THIS file, then run the sync. Commands are relative to the project root (launch the harness there); the scripts resolve every other path from their own location.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/inject_state.py",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/track_edits.py --phase prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task)$|spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/route_model.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/track_edits.py",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/check_ledgers_on_stop.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 .agents/hooks/refresh_state.py",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/subagent_track.py --start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/subagent_track.py --stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
